# Cluster (Qianfan / CFS) settings for run_search_tag_distill_qwen3_8b.sh.
# Copy to the repo root as `.env`, or point ENV_FILE at this file:
#   ENV_FILE=examples/seed_trainer/env.cfs.example bash examples/seed_trainer/run_search_tag_distill_qwen3_8b.sh

# conda env inside the training container (set to empty to use the current shell)
CONDA_ENV="${CONDA_ENV:-copd}"

# --- models -----------------------------------------------------------------
# MODELS_ROOT is where the launcher looks for Qwen3-8B-search-tag-sft and, as a
# fallback, the base Qwen3-8B. Checkpoints go to $MODELS_ROOT/ckpt/$EXPERIMENT_NAME.
MODELS_ROOT="${MODELS_ROOT:-/mnt/cfs_algo_bj/models/opensource_model/Qwen}"
# Uncomment to pin the student explicitly (skips the tag-SFT lookup):
# HF_MODEL_PATH=/mnt/cfs_algo_bj/models/opensource_model/Qwen/Qwen3-8B

# --- data -------------------------------------------------------------------
TRAIN_DATA="${TRAIN_DATA:-/mnt/cfs_algo_bj/workspace/lijiachun/searchr1_data/nq_search/train.parquet}"
VAL_DATA="${VAL_DATA:-/mnt/cfs_algo_bj/workspace/lijiachun/searchr1_data/nq_search/test.parquet}"

# --- services ---------------------------------------------------------------
# Retriever (examples/search/retriever/retrieval_launch.sh) and the Qwen3-30B
# teacher replicas used by the analyzer and log-prob scoring.
SEARCH_URL="${SEARCH_URL:-http://127.0.0.1:8000/retrieve}"
# TEACHER_BASE_URL may be a comma-separated replica list. Scoring spreads
# batches round-robin across all replicas (dead ones are skipped on retry);
# the analyzer (writes a_T) uses the FIRST entry unless OPENAI_BASE_URL is set.
# 20-card teacher example (5 replicas of TP=4, started with `seedctl teacher`):
#   TEACHER_BASE_URL="http://ip1:8100/v1,http://ip2:8100/v1,http://ip2:8101/v1,http://ip3:8100/v1,http://ip3:8101/v1"
TEACHER_BASE_URL="${TEACHER_BASE_URL:-http://127.0.0.1:8100/v1}"
TEACHER_MODEL="${TEACHER_MODEL:-Qwen3-30B-A3B-Instruct-2507}"
TEACHER_API_KEY="${TEACHER_API_KEY:-EMPTY}"

# Scoring throughput knobs (defaults are tuned; raise CONCURRENCY with more
# replicas — a good starting point is 4-8 in flight per replica).
# SEED_EXTERNAL_TEACHER_CONCURRENCY=16
# SEED_EXTERNAL_TEACHER_BATCH_SIZE=16

# --- outputs ----------------------------------------------------------------
# CFS is shared, so keep checkpoints and rollout dumps off the pod's local disk.
DEFAULT_LOCAL_DIR="${DEFAULT_LOCAL_DIR:-/mnt/cfs_algo_bj/workspace/lijiachun/ckpt/tag_distill_qwen3_8b_search_rkl_errsel}"

# --- scale ------------------------------------------------------------------
N_GPUS_PER_NODE="${N_GPUS_PER_NODE:-8}"
TOTAL_TRAINING_STEPS="${TOTAL_TRAINING_STEPS:-150}"
