# Cluster (Qianfan / CFS) settings for run_search_tag_distill_qwen3_8b.sh.
# Copy to the repo root as `.env`, or point ENV_FILE at this file:
#   ENV_FILE=examples/seed_trainer/env.cfs.example bash examples/seed_trainer/run_search_tag_distill_qwen3_8b.sh

# conda env inside the training container (set to empty to use the current shell)
CONDA_ENV=copd

# --- models -----------------------------------------------------------------
# MODELS_ROOT is where the launcher looks for Qwen3-8B-search-tag-sft and, as a
# fallback, the base Qwen3-8B. Checkpoints go to $MODELS_ROOT/ckpt/$EXPERIMENT_NAME.
MODELS_ROOT=/mnt/cfs_algo_bj/models/opensource_model/Qwen
# Uncomment to pin the student explicitly (skips the tag-SFT lookup):
# HF_MODEL_PATH=/mnt/cfs_algo_bj/models/opensource_model/Qwen/Qwen3-8B

# --- data -------------------------------------------------------------------
TRAIN_DATA=/mnt/cfs_algo_bj/workspace/lijiachun/searchr1_data/nq_search/train.parquet
VAL_DATA=/mnt/cfs_algo_bj/workspace/lijiachun/searchr1_data/nq_search/test.parquet

# --- services ---------------------------------------------------------------
# Retriever (examples/search/retriever/retrieval_launch.sh) and the single
# Qwen3-30B teacher server used by both the analyzer and log-prob scoring.
SEARCH_URL=http://127.0.0.1:8000/retrieve
TEACHER_BASE_URL=http://127.0.0.1:8100/v1
TEACHER_MODEL=Qwen3-30B-A3B-Instruct-2507
TEACHER_API_KEY=EMPTY

# --- outputs ----------------------------------------------------------------
# CFS is shared, so keep checkpoints and rollout dumps off the pod's local disk.
DEFAULT_LOCAL_DIR=/mnt/cfs_algo_bj/workspace/lijiachun/ckpt/tag_distill_qwen3_8b_search_rkl_errsel

# --- scale ------------------------------------------------------------------
N_GPUS_PER_NODE=8
TOTAL_TRAINING_STEPS=150
